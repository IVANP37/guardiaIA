# --- Local (npm run dev) ---
VITE_OLLAMA_BASE_URL="http://127.0.0.1:11434"
VITE_OLLAMA_MODEL="llama3.1"

# --- Docker / VPS Hostinger ---
# Si Ollama está en OTRO proyecto Docker, GuardIA entra a esa red.
# No abras el 11434 a internet.
APP_PORT=3003
OLLAMA_NETWORK=PONER_NOMBRE_DE_LA_RED
OLLAMA_UPSTREAM=http://ollama:11434
OLLAMA_MODEL=llama3.1
