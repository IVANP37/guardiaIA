# --- Local (npm run dev) ---
VITE_OLLAMA_BASE_URL="http://127.0.0.1:11434"
VITE_OLLAMA_MODEL="llama3.1"

# --- Docker / VPS Hostinger ---
# El navegador no habla con Ollama directo. Nginx en el contenedor proxea /api al host.
APP_PORT=80
OLLAMA_UPSTREAM=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
